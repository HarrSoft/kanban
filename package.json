{
	"name": "@harrsoft/kanban",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bunx -b vite dev",
		"build": "bunx -b vite build",
		"preview": "bunx -b vite preview",
		"prepare": "bunx -b svelte-kit sync || echo ''",
		"check": "bunx -b svelte-kit sync && bunx -b svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bunx -b svelte-kit sync && bunx -b svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "bunx -b prettier --write .",
		"lint": "bunx -b prettier --check . && eslint .",
		"test:unit": "bunx -b vitest --project server",
		"test": "bunx -b run test:unit -- --run && bunx -b run test:e2e",
		"test:e2e": "bunx -b playwright test",
		"db:push": "bunx -b drizzle-kit push",
		"db:generate": "bunx -b drizzle-kit generate",
		"db:migrate": "bunx -b drizzle-kit migrate",
		"db:studio": "bunx -b drizzle-kit studio"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.2",
		"@playwright/test": "^1.58.1",
		"@sveltejs/adapter-auto": "^6.1.1",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.18",
		"@types/bun": "^1.3.8",
		"@types/node": "^22.19.8",
		"@vitest/browser": "^3.2.4",
		"dotenv-cli": "^11.0.0",
		"drizzle-kit": "^0.31.8",
		"drizzle-orm": "^0.44.7",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^16.5.0",
		"pg": "^8.18.0",
		"playwright": "^1.58.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.49.1",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.3.6",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0",
		"vite": "^7.3.1",
		"vitest": "^3.2.4",
		"vitest-browser-svelte": "^1.1.0"
	},
	"dependencies": {
		"@harrsoft/logger": "harrsoft/logger",
		"@oslojs/crypto": "^1.0.1",
		"@paralleldrive/cuid2": "^3.3.0",
		"argon2": "^0.44.0",
		"date-fns": "^4.1.0",
		"drizzle-seed": "^0.3.1",
		"postgres": "^3.4.9",
		"quill": "^2.0.3",
		"svelte-dnd-action": "^0.9.68",
		"valibot": "^1.2.0"
	}
}
